"n":4107,"ref":"107","ta":["இன்புற்றசீலத்திராமாநுச என்றுமெவ்விடத்தும்","என் புற்றநோய் உடல்தோறும் பிறந்திறந்து எண்ணரிய","துன்புற்று வீயினும் சொல்லுவதொன்றுண்டுன் தொண்டர்கட்கே","அன்புற்றிருக்கும்படி என்னையாக்கியங் காட்படுத்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4108,"ref":"108","ta":["அங்கயல்பாய்வயல்தென்னரங்கன் அணியாகமன்னும்","பங்கயமாமலர்ப்பாவையைப் போற்றுதும் பத்தியெல்லாம்","தங்கியதென்னத்தழைத்து நெஞ்சேநந்தலைமிசையே","பொங்கியகீர்த்தி இராமாநுசனடிப் பூமன்னவே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}}]