,{"n":4061,"ref":"61","ta":["கொழுந்துவிட்டோடிப்படரும் வெங்கோள்வினையால் நிரயத்","தழுந்தியிட்டேனை வந்தாட்கொண்ட பின்னும் அருமுனிவர்","தொழுந்தவத்தோனெம்மிராமாநுசன் தொல்புகழ்சுடர்மிக்","கெழுந்தது அத்தால் நல்லதிசயங்கண்டதிருநிலமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4062,"ref":"62","ta":["இருந்தேனிருவினைப்பாசம் கழற்றி இன்றியானிறையும்","வருந்தேனினியெம்மிராமா னுசன் மன்னுமாமலர்த்தாள்","பொருந்தாநிலையுடைப்புன்மையினோர்க்கொன்றும் நன்மை செய்யாப்","பெருந்தேவரைப்பரவும் பெரியோர்தம்கழல் பிடித்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4063,"ref":"63","ta":["பிடியைத் தொடரும்களிறென்ன யானுன்பிறங்கியசீர்","அடியைத் தொடரும்படி நல்க வேண்டும் அறுசமயச்","செடியைத் தொடரும்மருள் செறிந்தோர் சிதைந் தோடவந்து இப்","படியைத் தொடரும் இராமாநுசாமிக்க பண்டிதனே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4064,"ref":"64","ta":["பண்டருமாறன் பசுந்தமிழ் ஆனந்தம் பாய்மதமாய்","விண்டிட எங்களி ராமாநுசமுனிவேழம் மெய்ம்மை","கொண்டநல்வேதக்கொழுந்தண்டமேந்திக் குவலயத்தே","மண்டிவந்தேன்றது வாதியர்காளுங்கள் வாழ்வற்றதே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4065,"ref":"65","ta":["வாழ்வற்றது தொல்லைவாதியர்க்கு என்றும் மறையவர்தம்","தாழ்வற்றது தவம் தாரணிபெற்றது தத்துவ நூல்","கூழற்றது குற்றமெல்லாம் பதித்தகுணத்தினர்க்கு அந்","நாழற்றது நம்மிராமாநுசன் தந்த ஞானத்திலே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4066,"ref":"66","ta":["ஞானம் கனிந்த நலங்கொண்டு நாடொறும் நைபவர்க்கு","வானம் கொடுப்பது மாதவன் வல்வினையேன் மனத்தில்","ஈனம் கடிந்தவிராமாநுசன் தன்னையெய்தினர்க்கு அத்","தானம் கொடுப்பது தன் தகவென்னும் சரண்கொடுத்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{"மாதவ":1}},{"n":4067,"ref":"67","ta":["சரணமடைந்ததருமனுக்கா பண்டு நூற்றுவரை","மரணமடைவித்தமாயவன் தன்னை வணங்கவைத்த","கரணமிவையுமக்கன்றென்றி ராமாநுசன் உயிர்கட்","கரணங்கமைத்திலனேல் அரணார்மற்றிவ் வாருயிர்க்கே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4068,"ref":"68","ta":["ஆரெனக்கின்றுநிகர்சொல்லில் மாயன்ன்றைவர் தெய்வத்","தேரினிற் செப்பிய கீதையின் செம்மை பொருள் தெரியப்","பாரினிற் சொன்னவிராமா னுசனைப் பணியும் நல்லோர்","சீரினிற் சென்று பணிந்தது என்னாவியும் சிந்தையுமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4069,"ref":"69","ta":["சிந்தையினோடுகரணங்கள் யாவும் சிதைந்து முன்னாள்","அந்தமுற்றாழ்ந்தது கண்டு அவையென்றனக்கன்றருளால்","தந்தவரங்கனும் தன்சரண்தந்திலன் தான து தந்து","எந்தையிராமாநுசன் வந்தெடுத்தன னின்றென்னையே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4070,"ref":"70","ta":["என்னையும் பார்த்தென்னியல்வையும் பார்த்து எண்ணில் பல்குணத்த","உன்னையும் பார்க்கில் அருள் செய்வதே நலம் அன்றியென்பால்","பின்னையும் பார்க்கில் நலமுளதே உன்பெருங்கருணை","தன்னையென்பார்ப்பர் இராமாநுசாவுன்னைச் சார்ந்தவரே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்","மகாபாரதம்"],"symbols":[],"names":{}},{"n":4071,"ref":"71","ta":["சார்ந்ததென்சிந்தையுன் தாளிணைக்கீழ் அன்புதான் மிகவும்","கூர்ந்தது அத்தாமரைத்தாள்களுக்கு உன்றன் குணங்களுக்கே","தீர்ந்ததென்செய்கை முன்செய்வினை நீ செய்வினையதனால்","பேர்ந்தது வண்மையிராமாநுசா எம் பெருந்தகையே."],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4072,"ref":"72","ta":["கைத்தனன் தீயசமயக்கலகரை காசினிக்கே","உய்த்தனன் தூயமறைநெறிதன்னை என்றுன்னியுள்ளம்","நெய்த்தவன் போடிருந்தேத்தும் நிறைபுகழோருடனே","வைத்தனனென்னை இராமாநுசன்மிக்க வண்மை செய்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4073,"ref":"73","ta":["வண்மையினாலும் தன்மாதகவாலும் மதிபுரையும்","தண்மையினாலுமித்தாரணியோர்கட்கு கான்சரணாய்","உண்மை நன்ஞானமுரைத்தவிராமாநுசனையுன்னும்","திண்மையல்லாலெனக்கில்லை மற்றோர் நிலை தேர்ந்திடிலே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4074,"ref":"74","ta":["தேரார்மறையின் திறமென்று மாயவன் தீயவரைக்","கூராழிகொண்டு குறைப்பது கொண்டலனையவண்மை","ஏரார்குணத்தெம்மிராமாநுசனவ் வெழில்மறையில்","சேராதவரைச்சிதைப்பது அப்போதொரு சிந்தை செய்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4075,"ref":"75","ta":["செய்த்தலைச்சங்கம் செழுமுத்தமீனும் திருவரங்கர்","கைத்தலத்தாழியும் சங்கமுமேந்தி நங்கண் முகப்பே","மொய்த்தலைத்துன்னைவிடேனென்றிருக்கிலும் நின்புகழே","மொய்த்தலைக்கும் வந்து இராமாநுசாவென்னை முற்றுநின்றே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":["சங்கு (பாஞ்சசன்யம்)"],"names":{}},{"n":4076,"ref":"76","ta":["நின்றவண் கீர்த்தியும் நீள்புனலும் நிறைவேங்கடப்பொற்","குன்றமும் வைகுந்தநாடும் குலவியபாற்கடலும்","உன்றனக்கெத்தனையின் பந்தரும் உன்னிணைமலர்த்தாள்","என்றனக்குமது இராமாநுசாவிவை யீந்தருளே"],"en":[],"gloss":[],"places":["திருவேங்கடம்","பரமபதம் (வைகுந்தம்)"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4077,"ref":"77","ta":["ஈந்தனனீயாதவின்னருள் எண்ணில் மறைக்குறும்பைப்","பாய்ந்தனன் அம்மறைப் பல்பொருளால் இப்படியனைத்தும்","ஏய்ந்தனன் கீர்த்தியினாலென்வினைகளை வேர்பறியக்","காய்ந்தனன் வண்மையிராமாநுசற்கென் கருத்தினியே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4078,"ref":"78","ta":["கருத்திற் புகுந்துள்ளில் கள்ளம் கழற்றி கருதரிய","வருத்தத்தினால் மிகவஞ்சித்து நீயிந்த மண்ணகத்தே","திருத்தித்திருமகள் கேள்வனுக்காக்கியபின் என்னெஞ்சில்","பொருத்தப்படாது எம்மிராமாநுசாமற்றோர் பொய்ப்பொருளே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":["திருமகள்"],"names":{}},{"n":4079,"ref":"79","ta":["பொய்யைச் சுரக்கும் பொருளைத் துரந்து இந்தப்பூதலத்தே","மெய்யைப்புரக்குமிராமாநுசன் நிற்க வேறு நம்மை","உய்யக்கொள்ளவல்லதெய்வமிங்கியாதென்றுலர்ந்து அவமே","ஐயப்படாநிற்பர் வையத்துள்ளோர் நல்லறிவிழந்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4080,"ref":"80","ta":["நல்லார்பரவுமிராமாநுசன் திருநாமம் நம்ப","வல்லார் திறத்தை மறவாதவர்கள் யவர் அவர்க்கே","எல்லாவிடத்திலுமென்றுமெப்போதிலு மெத்தொழும்பும்","சொல்லால் மனத்தால் கருமத்தினால் செய்வன் சோர்வின்றியே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4081,"ref":"81","ta":["சோர்வின்றியுன்றன் துணையடிக்கீழ் தொண்டுப்பட்டவர்பால்","சார்வின்றிநின்றவெனக்கு அரங்கன் செய்யதாளிணைகள்","பேர்வின்றியின்றுபெறுத்துமிராமாநுசா இனியுன்","சீரொன்றிய கருணைக்கு இல்லைமாறு தெரிவுறிலே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4082,"ref":"82","ta":["தெரிவுற்றஞானம் செறியப்பெறாது வெந்தீவினையால்","உருவற்ற ஞானத்துழல்கின்றவென்னை ஒருபொழுதில்","பொருவற்ற கேள்வியனாக்கிநின்றானென்ன புண்ணியனோ","தெரிவுற்ற கீர்த்தி இராமாநுசனென்னும் சீர்முகிலே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4083,"ref":"83","ta":["சீர்கொண்டுபேரறம் செய்து நல்வீடுசெறிதுமென்னும்","பார்கொண்டமேன்மையர் கூட்டனல்லேன் உன்பதயுகமாம்","ஏர்கொண்டவீட்டையெளிதினிலெய்துவன் உன்னுடைய","கார்கொண்டவண்மை இராமாநுசா இதுகண்டு கொள்ளே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4084,"ref":"84","ta":["கண்டுகொண்டேனெம்மிராமாநுசன் றன்னை காண்டலுமே","தொண்டு கொண்டேனவன் தொண்டர்பொற்றாளில் என் தொல்லை வெந்நோய்","விண்டுகொண்டேனவன் சீர்வெள்ளவாரியை வாய்மடுத்தின்","றுண்டுகொண்டேன் இன்னமுற்றனவோதிலுலப்பில்லையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4085,"ref":"85","ta":["ஓதியவேதத்தினுட்பொருளாய் அதனுச்சிமிக்க","சோதியை நாதனெனவறியா துழல்கின்ற தொண்டர்","பேதைமை தீர்த்தவிராமாநுசனைத் தொழும் பெரியோர்","பாதமல்லாலென்றன்னாருயிர்க்கு யாதொன்றும் பற்றில்லையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4086,"ref":"86","ta":["பற்றாமனிசரைப்பற்றி அப்பற்றுவிடாதவரே","உற்றாரெனவுழன்றோடிநையேனினி ஒள்ளிய நூல்","கற்றார்பரவுமிராமாநுசனைக் கருதுமுள்ளம்","பெற்றார்யவர் அவரெம்மைநின்றாளும் பெரியவரே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4087,"ref":"87","ta":["பெரியவர் பேசிலும் பேதையர்பேசிலும் தன்குணங்கட்","குரிய சொல்லென்று முடையவனென்றென்று உணர்வில் மிக்கோர்","தெரியும் வண்கீர்த்தியிராமா