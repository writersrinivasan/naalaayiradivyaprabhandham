[{"n":4001,"ref":"1","ta":["பூமன்னுமாது பொருந்திய மார்பன் புகழ்மலிந்த","பாமன்னுமாற னடிபணிந்துய்ந்தவன் பல்கலையோர்","தாம்மன்னவந்தவிராமாது சன் சரணாரவிந்தம்","நாம்மன்னிவாழ நெஞ்சே சொல்லுவோமவன் நாமங்களே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4002,"ref":"2","ta":["கள்ளார் பொழில் தென்னரங்கன் கமலப்பதங்கள் நெஞ்சிற்","கொள்ளாமனிசரைநீங்கி குறையல்பிரானடிக்கீழ்","விள்ளாதவன் பனிராமாநுசன்மிக்க சீலமல்லால்","உள்ளாதென்னெஞ்சு ஒன்றறியேனெனக்குற்றபேரியல்வே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4003,"ref":"3","ta":["பேரியல்நெஞ்சே அடிபணிந்தேனுன்னை பேய்ப்பிறவிப்","பூரியரோடுள்ள சுற்றம் புலத்தி பொருவரும்சீர்","ஆரியன் செம்மையிராமாநுசமுனிக் கன்பு செய்யும்","சீரிய பேறுடையார் அடிக்கீழென்னைச் சேர்த்ததற்கே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4004,"ref":"4","ta":["என்னைப்புவியிலொருபொருளாக்கி மருள்சுரந்த","முன்னைப்பழவினை வேரறுத்து ஊழிமுதல்வனையே","பன்னப்பணித்தவிராமாநுசன் பரன் பாதமுமென்","சென்னித்தரிக்க வைத்தான் எனக்கேதும் சிதைவில்லையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4005,"ref":"5","ta":["எனக்குற்ற செல்வமிராமாநுசனென்று இசையகில்லா","மனக்குற்றமாந்தர் பழிக்கில் புகழ் அவன் மன்னியசீர்","தனக்குற்றவன் பரவன் திருநாமங்கள் சாற்றும் என்பா","வினக்குற்றம் காணகில்லார் பத்தியேய்ந்தவியல் விதென்றே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4006,"ref":"6","ta":["இயலும் பொருளுமிசையத்தொடுத்து நன்கவிகளன்பால்","மயல் கொண்டு வாழ்த்து மிராமாநுசனை மதியின்மையால்","பயிலும் கவிகளில் பத்தியில்லாதவென்பாவிநெஞ்சால்","முயல்கின்றனன் அவன்றன் பெருங்கீர்த்திமொழிந்திடவே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4007,"ref":"7","ta":["மொழியைக் கடக்கும் பெரும்புகழான் வஞ்சமுக்குறும்பாம்","குழியைக் கடக்கும் நம் கூரத்தாழ்வான் சரண் கூடியபின்","பழியைக் கடத்துமிராமாநுசன் புகழ்பாடி அல்லா","வழியைக் கடத்தல் எனக்கினியாதும் வருத்தமன்றே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4008,"ref":"8","ta":["வருத்தும் புறவிருள்மாற்ற எம்பொய்கைப்பிரான்மறையின்","குருத்தின் பொருளையும் செந்தமிழ்தன்னையும் கூட்டி ஒன்றத்","திரித்தன்றெரித்த திருவிளக்கைத் தன் திருவுள்ளத்தே","யிருத்தும்பரமன் இராமாநுசனெம்மிறையவனே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4009,"ref":"9","ta":["இறைவனைக்காணு மிதயத்திருள்கெட ஞானமென்னும்","நிறைவிளக்கேற்றிய பூதத்திருவடிதாள்கள் நெஞ்சத்","துறையவைத்தாளுமிராமாநுசன்புகழோதும் நல்லோர்","மறையினைக்காத்து இந்த மண்ணகத்தேமன்னவைப்பவரே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4010,"ref":"10","ta":["மன்னிய பேரிருள்மாண்ட பின் கோவலுள் மாமலராள்","தன்னொடுமாயனைக் கண்டமைகாட்டும் தமிழ்த்தலைவன்","பொன்னடி போற்று மிராமாநுசற்கன்புபூண்டவர்தாள்","சென்னியிற் சூடும் திருவுடையாரென்றும் சீரியரே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4011,"ref":"11","ta":["சீரிய நான்மறைச் செம்பொருள் செந்தமிழாலளித்த","பாரியலும்புகழ்ப் பாண்பெருமாள் சரணாம்பதுமத்","தாரியல் சென்னி யிராமாநுசன்றன்னைச் சார்ந்தவர்தம்","காரியவண்மை என்னால் சொல்லொணாதிக்கடலிடத்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4012,"ref":"12","ta":["இடங்கொண்ட கீர்த்தி மழிசைக்கிறைவன் இணையடிப்போ","தடங்குமிதயத் திராமாநுசன் அம்பொற்பாதமென்றும்","கடங்கொண்டிறைஞ்சும் திருமுனிவர்க்கன்றிக்காதல் செய்யாத்","திடங்கொண்டஞானியர்க்கே அடியேனன்பு செய்வதுவே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4013,"ref":"13","ta":["செய்யும் பசுந்துளபத்தொழில்மாலையும் செந்தமிழில்","பெய்யும் மறைத்தமிழ் மாலையும் பேராதசீரங்கத்","தையன் கழற்கணியும் பரன் தாளன்றி ஆதரியா","மெய்யன் இராமாநுசன்சாணேகதி வேறெனக்கே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4014,"ref":"14","ta":["கதிக்குப்பதறி வெங்கானமும் கல்லும் கடலுமெல்லாம்","கொதிக்கத் தவம் செய்யும் கொள்கையற்றேன் கொல்லிகாவலன் சொல்","பதிக்கும் கலைக்கவிபாடும் பெரியவர்பாதங்களே","துதிக்கும் பரமன் இராமாநுசனென்னைச் சோர்விலனே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4015,"ref":"15","ta":["சோராதகாதல் பெருஞ்சுழிப்பால் தொல்லைமாலையொன்றும்","பாராது அவனைப்பல்லாண்டென்று காப்பிடும் பான்மையன் தாள்","பேராதவுள்ளத் திராமாநுசன்றன் பிறங்கியசீர்","சாராமனிசரைச்சேரேன் எனக்கென்ன தாழ்வினியே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4016,"ref":"16","ta":["தாழ்வொன்றில்லாமறைதாழ்ந்து தலமுழுதும்கலியே","ஆள்கின்ற நாள் வந்து அளித்தவன் காண்மின் அரங்கர்மௌலி","சூழ்கின்றமாலையைச் சூடிக்கொடுத்தவள் தொல்லருளால்","வாழ்கின்றவள்ளல் இராமா னுசனென்னும் மாமுனியே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4017,"ref":"17","ta":["முனியார் துயரங்கள் முந்திலும் இன்பங்கள் மொய்த்திடினும்","கனியார்மனம் கண்ணமங்கைநின்னை சுலேபரவும்","தனியானையைத்தண்டமிழ் செய்த நீலன் றனக்கு உலகில்","இனியானை எங்களிராமாநுசனை வந்தெய்தினரே"],"en":[],"gloss":[],"places":["திருவரங்கம்","திருக்கண்ணமங்கை"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4018,"ref":"18","ta":["எய்தற்கரிய மறைகளை ஆயிரமின் தமிழால்","செய்தற்குலகில் வரும் சடகோபனை சிந்தையுள்ளே","பெய்தற்கிசையும் பெரியவர்சீரையுயிர்களெல்லாம்","உய்தற்குதவும் இராமாநுசனெம்முறு துணையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4019,"ref":"19","ta":["உறுபெருஞ்செல்வமும் தந்தையும் தாயும் உயர்குருவும்","வெறிதருபூமகள் நாதனும் மாறன் விளங்கியசீர்","நெறிதரும் செந்தமி ழாரணமேயென்றிந்நீணிலத்தோர்","அறிதரநின்ற இராமாநுசனெனக்காரமுதே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":["திருமகள்"],"names":{}},{"n":4020,"ref":"20","ta":["ஆரப்பொழில் தென்குருகைப்பிரான் அமுதத்திருவா","யீரத்தமிழி னிசையுணர்ந்தோர்கட்கு இனியவர்தம்","சீரைப்பயின்றுய்யும் சீலங்கொள் நாதமுனியை நெஞ்சால்","வாரிப்பருகும் இராமாநுசனென்றன் மாநிதியே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4021,"ref":"21","ta":["நிதியைப் பொழியும் முகிலென்று நீசர்தம் வாசல்பற்றித்","துதிகற்றுலகில் துவள்கின்றிலேனினி தூய்நெறிசேர்","எதிகட்கிறைவன் யமுனைத்துறைவனிணையடியாம்","கதிபெற்றுடைய இராமா னுசனென்னைக்காத்தனனே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4022,"ref":"22","ta":["கார்த்திகையானும் கரிமுகத்தானும் கனலும் முக்கண்","மூர்த்தியும் மோடியும் வெப்பும் முதுகிட்டு மூவுலகும்","பூத்தவனேயென்று போற்றிட வாணன் பிழை பொறுத்த","தீர்த்தனை யேத்தும் இராமாநுசனென்றன் சேமவைப்பே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4023,"ref":"23","ta":["வைப்பாய்வான் பொருளென்று நல்லன்பர் மனத்தகத்தே","எப்போதும் வைக்கு மிராமாநுசனை இருநிலத்தில்","ஒப்பாரிலாத வுறுவினையேன்வஞ்சநெஞ்சில்வைத்து","முப்போதும் வாழ்த்துவன் என்னாமிது அவன் மொய்புகழ்க்கே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4024,"ref":"24","ta":["மொய்த்த வெந்தீவினையால் பல்லுடல்தொறும் மூத்து அதனால்","எய்த்தொழிந்தேன் முன்நாள்களெல்லாம் இன்று கண்டுயர்ந்தேன்","பொய்த்தவம் போற்றும் புலைச்சமயங்கள் நிலத்தவியக்","கைத்தமெய்ஞ்ஞானத்து இராமாநுசனென்னும் கார்தன்னையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4025,"ref":"25","ta":["காரேய் கருணையிராமாநுச இக்கடலிடத்தில்","ஆரேயறிபவர் நின்னருளின் தன்மை அல்லலுக்கு","நேரேயுறைவிடம் நான் வந்து நீயென்னையுய்த்த பின் உன்","சீரேயுயிர்க்குயிராய் அடியேற்கின்று தித்திக்குமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4026,"ref":"26","ta":["திக்குற்றகீர்த்தி யிராமாநுசனை என் செய்வினையாம்","மெய்க்குற்றம் நீக்கி விளங்கிய மேகத்தை மேவும் நல்லோர்","எக்குற்றவாள ரெது பிறப்பேதியல்வாகநின்றோர்","அக்குற்றமப்பிறப்பு அவ்வியல் வேநம்மையாட்கொள்ளுமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4027,"ref":"27","ta":["கொள்ளக்குறைவற்றிலங்கிகொழுந்துவிட் டோங்கியவுன்","வள்ளல் தனத்தினால் வல்வினையேன் மனம் நீ புகுந்தாய்","வெள்ளைச்சுடர்விடு முன்பெருமேன்மைக்கிழுக்கிதென்று","தள்ளுற்றிரங்கும் இராமாநுசவென் தனிநெஞ்சமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4028,"ref":"28","ta":["நெஞ்சில்கறை கொண்ட கஞ்சனைக்காய்ந்த நிமலன் நங்கள்","பஞ்சித்திருவடிப் பின்னை தன் காதலன் பாதம் நண்ணா","வஞ்சர்க்கரியவிராமா னுசன் புகழன்றியென்வாய்","கொஞ்சிப்பரவகில்லாது என்ன வாழ்வின்று கூடியதே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4029,"ref":"29","ta":["கூட்டும் விதியென்று கூடுங்கொலோ தென்குருகைப்பிரான்","பாட்டென்னும் வேதப்பசுந்தமிழ் தன்னை தன்பத்தியென்னும்","வீட்டின் கண்வைத்தவிராமா னுசன் புகழ்மெய்யுணர்ந்தோர்","ஈட்டங்கள் தன்னை என் நாட்டங்கள் கண்டின்பமெய்திடவே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4030,"ref":"30","ta":["இன்பந்தருபெருவீடுவந்தெய்திலென் எண்ணிறந்த","துன்பந்தரு நிரயம்பல சூழிலென் தொல்லுலகில்","மன்பல்லுயிர்கட்கிறையவன்மாயனெனமொழிந்த","அன்பனனகன் இராமாநுசனென்னையாண்டனனே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4031,"ref":"31","ta":["ஆண்டுகள் நாள் திங்களாய் நிகழ்காலமெல்லாம் மனமே","ஈண்டு பல்யோனிகள் தோறுழல்வோம் இன்றோரெண்ணின்றியே","காண்டகுதோளண்ணல் தென்னத்தியூரர்கழலிணைக்கீழ்ப்","பூண்டவன்பாளன் இராமாநுசனைப் பொருந்தினமே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4032,"ref":"32","ta":["பொருந்திய தேசும் பொறையும் திறலும் புகழும் நல்ல","திருந்தியஞானமும் செல்வமும் சேரும் செறுகலியால்","வருந்தியஞாலத்தை வண்மையினால் வந்தெடுத்தளித்த","அருந்தவன் எங்களிராமாநுசனையடைபவர்க்கே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4033,"ref":"33","ta":["அடையார் கமலத்து அலர்மகள் கேள்வன் கையாழியென்னும்","படையோடு நாந்தகமும்படர்தண்டும் ஒண்சார்ங்கவில்லும்","புடையார் புரிசங்கமுமிந்தப்பூதலம் காப்பதற்கென்று","இடையே இராமாநுசமுனியாயினவிந்நிலத்தே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":["சார்ங்கம் (வில்)"],"names":{}},{"n":4034,"ref":"34","ta":["நிலத்தைச் செறுத்துண்ணும் நீ சக்கலியை நினைப்பரிய","பெலத்தைச் செறுத்தும் பிறங்கியதில்லை என்பெய்வினை தென்","புலத்தில் பொறித்தவப் புத்தகச்சும்மைபொறுக்கியபின்","நலத்தைப் பொறுத்தது இராமாநுசன்றன் நயப்புகழே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4035,"ref":"35","ta":["நயவேனொரு தெய்வம் நானிலத்தே சிலமானிடத்தைப்","புயலேயெனக் கவிபோற்றி செய்யேன் பொன்னரங்கமென்னில்","மயலே பெருகு மிராமாநுசன்மன்னுமாமலர்த்தாள்","அயரேன் அருவினையென்னையெவ்வாறின்றடர்ப்பதுவே"],"en":[],"gloss":[],"places":["திருவரங்கம்"],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4036,"ref":"36","ta":["அடல் கொண்டநேமிய னாருயிர் நாதன் அன்றாரணச்சொல்","கடல் கொண்டவொண்பொருள் கண்டளிப்ப பின்னும் காசினியோ","ரிடரின்கண் வீழ்ந்திடத் தானுமவ்வொண்பொருள் கொண்டு அவர்பின்","படரும்குணன் எம்மிராமாநுசன்றன் படியிதுவே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":["சக்கரம் (சுதர்சனம்)"],"names":{}},{"n":4037,"ref":"37","ta":["படி கொண்ட கீர்த்தி யிராமாயணமென்னும்பத்திவெள்ளம்","குடிகொண்ட கோயிலிராமாநுசன் குணங்கூறும் அன்பர்","கடிகொண்டமாமலர்த்தாள்கலந்துள்ளங்கனியும் நல்லோர்","அடிகண்டுகொண்டு கந்து என்னையுமாளவர்க்காக்கினரே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4038,"ref":"38","ta":["ஆக்கியடிமைநிலைப்பித்தனையென்னையின்று அவமே","போக்கிப்புறத்திட்டதென்பொருளாமுன்பு புண்ணியர்தம்","வாக்கிற்பிரியாவிராமாநுசநின் னருளின் வண்ணம்","நோக்கில் தெரிவரிதால் உரையாயிந்த நுண்பொருளே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4039,"ref":"39","ta":["பொருளும்புதல் வரும் பூமியும் பூங்குழலாருமென்றே","மருள் கொண்டிளைக்கும் நமக்கு நெஞ்சே மற்றுளார்தர","இருள்கொண்ட வெந்துயர்மாற்றித்தன்னீறில் பெரும்புகழே","தெருளும் தெருள் தந்து இராமாநுசன் செய்யும் சேமங்களே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்"],"symbols":[],"names":{}},{"n":4040,"ref":"40","ta":["சேமநல்வீடும் பொருளும் தருமமும் சீரிய நற்","காமமும் என்றிவை நான் கென்பர் நான்கினும் கண்ணனுக்கே","ஆமது காம மறம்பொருள் வீடிதற்கென்றுரைத்தான்","வாமனன் சீலன் இராமாநுசனிந்தமண்மிசையே"],"en":[],"gloss":[],"places":[],"stories":["இராமாவதாரம்","வாமன / திரிவிக்கிரம