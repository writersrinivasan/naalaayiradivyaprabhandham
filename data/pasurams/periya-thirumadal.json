[{"n":2751,"ref":"கண்ணி 1","ta":["மன்னிய பல்பொறிசே ராயிரவாய் வாளரவின்","சென்னி மணிக்குடுமித் தெய்வச் சுடர்நடுவுள்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2752,"ref":"கண்ணி 2","ta":["மன்னிய நாகத் தணைமேலோர் மாமலைபோல்","மின்னும் மணிமகர குண்டலங்கள் வில்வீச"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2753,"ref":"கண்ணி 3","ta":["துன்னிய தாரகையின் பேரொளிசே ராகாசம்","என்னும் விதானத்தின் கீழா லிருசுடரை"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2754,"ref":"கண்ணி 4","ta":["மின்னும் விளக்காக யேற்றி மறிகடலும்","பன்னு திரைக்கவரி வீச நிலமங்கை"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2755,"ref":"கண்ணி 5","ta":["தன்னை முனநா ளளவிட்ட தாமரைபோல்","மன்னிய சேவடியை வானியங்கு தாரகைமீன்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2756,"ref":"கண்ணி 6","ta":["என்னும் மலர்ப்பிணையா லேய்ந்த மழைக்கூந்தல்","தென்ன னுயர்பொருப்பும் தெய்வ வடமலையும்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2757,"ref":"கண்ணி 7","ta":["என்னு மிவையே முலையா வடிவமைந்த","அன்ன நடைய வணங்கே யடியிணையைத்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2758,"ref":"கண்ணி 8","ta":["தன்னுடைய வங்கைகளால் தான்தடவத் தான்கிடந்தோர்","உன்னிய யோகத் துறக்கம் தலைக்கொண்ட"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2759,"ref":"கண்ணி 9","ta":["பின்னை தன்னாபி வலயத்துப் பேரொளிசேர்","மன்னிய தாமரை மாமலர்ப்பூத் தம்மலர்மேல்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2760,"ref":"கண்ணி 10","ta":["முன்னம் திசைமுகனைத் தான்படைக்க மற்றவனும்","முன்னம் படைத்தனன் நான்மறைக ளம்மறைதான்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2761,"ref":"கண்ணி 11","ta":["மன்னு மறம்பொருள் இன்பம்வீ டென்றுலகில்","நன்னெறிமேம் பட்டன நான்கன்றே நான்கினிலும்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2762,"ref":"கண்ணி 12","ta":["பின்னையது பின்னைப் பெயர்த்தரு மென்பதோர்","தொன்னெறியை வேண்டுவார் வீழ்கனியு மூழிலையும்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2763,"ref":"கண்ணி 13","ta":["என்னு மிவையே நுகர்ந்துடலம் தாம்வருந்தி","துன்னு மிலைக்குரம்பைத் துஞ்சியும் வெஞ்சுடரோன்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2764,"ref":"கண்ணி 14","ta":["மன்னு மழல்நுகர்ந்தும் வண்தடத்தி னுட்கிடந்தும்","இன்னதோர் தன்மையரா யீங்குடலம் விட்டெழுந்து"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2765,"ref":"கண்ணி 15","ta":["தொன்னெறிக்கட் சென்றா ரெனப்படும் சொல்லல்லால்","இன்னதோர் காலத் தினையா ரிதுபெற்றார்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2766,"ref":"கண்ணி 16","ta":["என்னவும் கேட்டறிவ தில்லை யுளதென்னில்","மன்னுங் கடுங்கதிரோன் மண்டலத்தின் நன்னடுவுள்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2767,"ref":"கண்ணி 17","ta":["அன்னதோ ரில்லியி னூடுபோய் வீடென்னும்","தொன்னெறிக்கட் சென்றாரைச் சொல்லுமின்கள் சொல்லாதே"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2768,"ref":"கண்ணி 18","ta":["அன்னதே பேசு மறிவில் சிறுமனத்தாங்","கன்னவரைக் கற்பிப்போம் யாமே யதுநிற்க"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2769,"ref":"கண்ணி 19","ta":["முன்னம்நான் சொன்ன வறத்தின் வழிமுயன்ற","அன்னவர்த்தாம் கண்டீர்க ளாயிரக்கண் வானவர்கோன்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2770,"ref":"கண்ணி 20","ta":["பொன்னகரம் புக்கமரர் போற்றிசெப்ப பொங்கொளிசேர்","கொன்னவிலும் கோளரிமாத் தாஞ்சுமந்த கோலஞ்சேர்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2771,"ref":"கண்ணி 21","ta":["மன்னிய சிங்கா சனத்தின்மேல் வாணொடுங்கண்","கன்னியரா லிட்ட கவரிப் பொதியவிழ்ந்தாங்"],"en":[],"gloss":[],"places":[],"stories":[],"symbols":[],"names":{}},{"n":2772,"ref":"கண்ணி 22","ta":["கின்னளம்பூந் தென்ற லியங்க மருங்கிருந்த","மின்னனைய நுண்மருங்குல் மெல்லியலார் வெண்முறுவல்"],"en":[],"gloss":[],"places